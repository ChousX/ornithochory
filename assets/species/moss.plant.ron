// Cushion moss as cover: clusters of low, lobed, overlapping mounds with
// a fine speckle of shoot tips and a few bristling shoots, hugging the
// ground. Dark, muted green, lighter on the mound tops; neighbours overlap
// into mats, on slopes too steep for grass too.
(
    name: "moss",
    variants: 6,
    form: Cover((
        tuft: Cushion(
            radius: 0.26,
            height: 0.05,
            sides: 8,
            lumps: 3,
            lobes: 0.35,
            bristles: 6,
            bristle_height: 0.45,
        ),
        color: (0.11, 0.16, 0.05),
        tip_color: Some((0.24, 0.29, 0.09)),
        shade: 0.45,
        color_jitter: 0.2,
        dry: 0.08,
        dry_color: (0.45, 0.30, 0.15),
        detail: 0.65,
        detail_size: 0.006,
    )),
    placement: (
        spacing: 0.4,
        probability: 0.78,
        slope: (min: 0.0, max: 70.0),
        noise: Some((frequency: 0.15, threshold: 0.25, octaves: 2)),
        align: 1.0,
        scale: (min: 0.5, max: 1.3),
        sink: 0.01,
    ),
)
