// A spruce by Weber & Penn style recursion: a straight leader with whorls
// of branches that shorten to the top, carrying flat, hanging sprays.
// Needles are never single: each blade is a spray's worth of them.
(
    name: "spruce",
    variants: 6,
    form: Structure((
        growth: Recursive((
            height: 10.5,
            step: 0.35,
            wander: 0.015,
            max_nodes: 5000,
            levels: [
                // Whorls of five, sagging then turning up at the tip, the
                // lowest pointing down, shortening to the top: a cone.
                (
                    count: 150, whorl: 5, span: (0.08, 0.97), angle: (92.0, 58.0),
                    length: 0.32, shape: Conical, step: 0.3,
                    curve: -20.0, curve_back: 30.0, wander: 0.05, jitter: 0.3,
                    roll: 33.0, planar: 0.0,
                ),
                // Flat sprays of branchlets off both flanks, hanging.
                (
                    count: 8, whorl: 2, span: (0.15, 0.9), angle: (60.0, 45.0),
                    length: 0.42, shape: Tapered, step: 0.3,
                    curve: -25.0, curve_back: 0.0, wander: 0.08, jitter: 0.3,
                    roll: 25.0, planar: 1.0,
                ),
            ],
        )),
        bark: (color: (0.27, 0.22, 0.19), roughness: 0.95, sides: 8, min_radius: 0.007),
        leaves: Some((
            color: (0.11, 0.26, 0.15),
            color_jitter: 0.12,
            length: 0.26,
            width: 0.12,
            tip_depth: 3,
            per_node: 3,
            droop: 0.2,
            segments: 1,
            along: 1.0,
            planar: 0.7,
            crown_normals: 0.6,
            inner_shade: 0.35,
        )),
        tip_radius: 0.006,
        pipe_exponent: 2.6,
    )),
    placement: (
        spacing: 5.0,
        probability: 0.4,
        slope: (0.0, 35.0),
        noise: Some((frequency: 0.015, threshold: 0.1, octaves: 2)),
        scale: (0.75, 1.25),
        sink: 0.15,
    ),
)
