// Meadow grass as cover: tussocks of curved, strap-shaped geometry blades,
// merged per patch. Dark roots under lighter, yellower tips and a few dry
// blades make the stand read as one dense mass (Ghost of Tsushima's grass).
(
    name: "grass",
    variants: 6,
    form: Cover((
        tuft: Blades(
            count: 16,
            height: 0.30,
            width: 0.011,
            lean: 0.6,
            segments: 3,
            spread: 0.6,
            height_jitter: 0.5,
            splay: 0.5,
        ),
        color: (0.14, 0.30, 0.05),
        tip_color: Some((0.34, 0.52, 0.11)),
        shade: 0.55,
        color_jitter: 0.12,
        dry: 0.07,
        dry_color: (0.66, 0.58, 0.36),
    )),
    placement: (
        spacing: 0.37,
        probability: 0.85,
        slope: (0.0, 38.0),
        noise: Some((frequency: 0.06, threshold: -0.3, octaves: 3)),
        align: 0.6,
        scale: (0.7, 1.3),
        sink: 0.02,
    ),
)
