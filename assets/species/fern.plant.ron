// A shield fern (Dryopteris) by parametric L-system: a vase of fronds from
// one crown, each a scaly stipe and a lanceolate blade of paired pinnae
// that are longest a fifth of the way up and shrink to the tip and, less,
// to the base; younger fronds stand straighter, and a couple of
// fiddleheads uncurl in the middle.
//
// In the rules: `t` runs 0 at the blade's base to 1 at its tip, `s` scales
// the whole frond.
(
    name: "fern",
    variants: 6,
    form: Structure((
        growth: LSystem((
            defines: {
                "fronds": 9,
                "pairs": 22,
                "stipe": 5,
                "croziers": 2,
            },
            axiom: "C(croziers) R(fronds)",
            rules: [
                // The rosette: older (outer) fronds lean out further.
                (symbol: 'R', params: ["k"], when: "k > 0",
                 to: "[ &(14 + 46 * k / fronds + rand(-6, 6)) $ ~(0.09) S(stipe, rand(0.8, 1.05)) ] /(137.5 + rand(-20, 20)) R(k - 1)"),
                (symbol: 'S', params: ["n", "s"], when: "n > 0",
                 to: "#(0.0045 * s) F(1.2 * s) S(n - 1, s)"),
                (symbol: 'S', params: ["n", "s"], when: "n <= 0", to: "P(pairs, s)"),
                (symbol: 'P', params: ["i", "s"], when: "i > 0", to: "Q(i, s, 1 - i / pairs)"),
                (symbol: 'P', params: ["i", "s"], when: "i <= 0", to: "#(0.0012) F(0.6 * s) L(0.18 * s)"),
                // One node of the blade: a thinning rachis and a pair of
                // pinnae, sweeping forward towards the tip.
                (symbol: 'Q', params: ["i", "s", "t"],
                 to: "#(s * (0.0034 * (1 - t) + 0.0012)) F(s * (1 - 0.45 * t)) [ +(80 - 38 * t) L(s * sqrt(1 - t) * min(1, 0.45 + 2.75 * t)) ] [ -(80 - 38 * t) L(s * sqrt(1 - t) * min(1, 0.45 + 2.75 * t)) ] P(i - 1, s)"),
                // Fiddleheads: a short stalk ending in a tightening coil.
                (symbol: 'C', params: ["k"], when: "k > 0",
                 to: "[ /(rand(0, 360)) &(rand(12, 26)) $ ~(0) #(0.0045) F(1.2) F(1.2) F(1) K(13, 0.9) ] C(k - 1)"),
                (symbol: 'K', params: ["n", "l"], when: "n > 0", to: "&(30) #(0.0035) F(l) K(n - 1, l * 0.86)"),
            ],
            generations: 90,
            max_modules: 6000,
            step: 0.03,
            step_scale: 1.0,
            angle: 30.0,
            angle_jitter: 4.0,
            tropism: (0.0, -1.0, 0.0),
            tropism_strength: 0.075,
        )),
        bark: (color: (0.26, 0.32, 0.12), roughness: 0.8, sides: 4),
        leaves: Some((
            color: (0.22, 0.46, 0.13),
            color_jitter: 0.12,
            length: 0.13,
            width: 0.046,
            tip_depth: 0,
            per_node: 1,
            droop: 0.2,
            segments: 3,
            lobes: 6,
            lod_keep: Some((0.6, 0.3)),
        )),
        tip_radius: 0.0008,
        pipe_exponent: 2.0,
    )),
    placement: (
        spacing: 1.4,
        probability: 0.35,
        slope: (min: 0.0, max: 40.0),
        noise: Some((frequency: 0.08, threshold: 0.15, octaves: 2)),
        align: 0.3,
        scale: (min: 0.7, max: 1.3),
        sink: 0.02,
    ),
)
