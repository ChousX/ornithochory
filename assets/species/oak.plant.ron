// A broadleaf tree by space colonization: the crown is an ellipsoid of
// attraction points, so its branches compete for space.
(
    name: "oak",
    variants: 6,
    form: Structure((
        growth: Colonize((
            envelope: Ellipsoid(center: (0.0, 5.6, 0.0), radii: (4.5, 3.0, 4.5)),
            points: 1500,
            influence: 1.8,
            kill: 0.45,
            step: 0.3,
            max_iterations: 120,
            tropism: (0.0, 0.04, 0.0),
            trunk_wander: 0.05,
            inertia: 0.35,
            smooth: 2,
        )),
        bark: (color: (0.30, 0.23, 0.17), roughness: 0.92, sides: 10, min_radius: 0.013),
        leaves: Some((
            color: (0.20, 0.40, 0.13),
            color_jitter: 0.18,
            length: 0.24,
            width: 0.19,
            tip_depth: 4,
            per_node: 2,
            droop: 0.4,
            segments: 1,
            cluster: 6,
            cluster_spread: 0.6,
            crown_normals: 0.7,
            inner_shade: 0.5,
            clumping: 0.3,
            clump_size: 1.6,
        )),
        tip_radius: 0.012,
        pipe_exponent: 2.25,
    )),
    placement: (
        spacing: 7.0,
        probability: 0.45,
        slope: (min: 0.0, max: 25.0),
        noise: Some((frequency: 0.02, threshold: -0.1, octaves: 3)),
        align: 0.0,
        scale: (min: 0.8, max: 1.2),
        sink: 0.15,
    ),
)
